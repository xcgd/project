<odoo>
    <record id="project_planning_search" model="ir.ui.view">
        <field name="name">project_planning_search</field>
        <field name="model">project.planning</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="project_id" />
                <field name="task_id" />
            </search>
        </field>
    </record>
    <record id="project_planning_tree" model="ir.ui.view">
        <field name="name">project_planning_tree</field>
        <field name="model">project.planning</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="project_id" />
                <field name="task_id" />
                <field name="parent_id" />
                <field name="is_parent" />
                <field name="is_expanded" />
                <field name="resource_id" />
                <field name="start_date" />
                <field name="end_date" />
                <field name="plan_start_date" />
                <field name="plan_end_date" />
            </tree>
        </field>
    </record>

    <record id="project_planning_jsgantt" model="ir.ui.view">
        <field name="name">project_planning_jsgantt</field>
        <field name="model">project.planning</field>
        <field name="arch" type="xml">
            <jsgantt
                time_format="month"
                show_duration="true"
                on_task_click="open_record"
            >
                <field name="name" mapping="name" />
                <field name="parent_id" mapping="parent_id" />
                <field name="is_parent" mapping="is_parent" />
                <field name="is_expanded" mapping="is_expanded" />
                <field name="resource_id" mapping="resource_id" />
                <field name="start_date" mapping="start_date" />
                <field name="end_date" mapping="end_date" />
                <field name="plan_start_date" mapping="plan_start_date" />
                <field name="plan_end_date" mapping="plan_end_date" />
                <field name="dependency_ids" mapping="dependency_ids" />
                <field name="color_class" mapping="class" />
            </jsgantt>
        </field>
    </record>

    <record id="project_planning_action" model="ir.actions.act_window">
        <field name="name">Gantt view of projects and tasks</field>
        <field name="res_model">project.planning</field>
        <field name="view_mode">jsgantt</field>
    </record>
    <menuitem
        id="project_planning_menu"
        name="Gantt"
        sequence="5"
        parent="project.menu_main_pm"
    >
      <menuitem
            id="project_planning_gantt_menu"
            name="Gantt view of projects and tasks"
            action="project_planning_action"
        />
    </menuitem>
</odoo>
